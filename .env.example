# Browser + server (recommended: duplicate anon URL/key with this prefix)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared-database store id. Production also maps this from the request Host.
NEXT_PUBLIC_STORE_ID=rogers-royal-golf

# Used by checkout redirect URLs; for Docker Compose use http://localhost:3010
NEXT_PUBLIC_APP_URL=

# Or server-only fallbacks (read by lib/supabase/env.ts)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only secret (never use NEXT_PUBLIC_*): orders, admin user list, admin catalog writes
# Exact name: SUPABASE_SERVICE_ROLE_KEY — same folder as package.json, restart dev after edits
# Double-quoted JWT values are OK
SUPABASE_SERVICE_ROLE_KEY=

# Required for admin (together with public.users.role = admin or app_metadata.role = admin)
# ADMIN_EMAILS=owner@example.com,other@example.com
ADMIN_EMAILS=
